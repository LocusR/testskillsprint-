# Порт Express-сервера (Vite проксі очікує 4000)
PORT=4000

# Дозволені origin'и фронтенду через кому
CORS_ORIGIN=http://localhost:5173

# --- BES Center ---
# Ендпоїнт, куди форвардяться заявки кандидатів
BES_CENTER_API_URL=https://bes-center.com/skill-sprint/external/candidates
# Секретний ключ BES Center. НІКОЛИ не потрапляє на фронтенд — тільки сюди.
BES_CENTER_API_KEY=replace-me

# --- reCAPTCHA v2 ---
# Секретний ключ із console.cloud.google.com/security/recaptcha.
# Site key (публічний) задається окремо у client/.env → VITE_RECAPTCHA_SITE_KEY.
# Порожній: у проді заявки відхиляються, у dev перевірка пропускається з попередженням.
RECAPTCHA_SECRET_KEY=

# Ліміт заявок з однієї IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

NODE_ENV=development
