# Змінні для docker compose. Скопіюйте у .env поруч із docker-compose.yml.
#   cp .env.example .env

# Порт, на якому сайт буде доступний зовні
WEB_PORT=8080

# --- Бекенд (runtime) ---
# Секрет BES Center для форварду заявок. Обовʼязковий — compose не стартує без нього.
BES_CENTER_API_KEY=
BES_CENTER_API_URL=https://bes-center.com/skill-sprint/external/candidates

# Секрет reCAPTCHA v2. Обовʼязковий — у проді капча працює fail-closed.
RECAPTCHA_SECRET_KEY=

# Порожній CORS_ORIGIN — фронт і API на одному origin через nginx.
# Заповнюйте, лише якщо API смикають зі стороннього домену (через кому).
CORS_ORIGIN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# --- Фронтенд (build-time!) ---
# Vite вшиває це у бандл під час збірки. Після зміни:
#   docker compose build --no-cache client && docker compose up -d
VITE_RECAPTCHA_SITE_KEY=6Lc_1mktAAAAAJmAZRUjlW76U4v35Qr6oKMXLqbb
VITE_GA_MEASUREMENT_ID=
